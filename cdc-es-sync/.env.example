# Copy to .env ONLY if it does not exist yet (the file holds your real credentials and is git-ignored):
#   Windows:  if not exist .env copy .env.example .env
#   Linux:    cp -n .env.example .env
# Real environment variables win over this file. docker compose reads it as well (env_file).

# --- Required ----------------------------------------------------------------------------------------------
ORACLE_USER=
ORACLE_PASSWORD=

# The service runs inside a container, so `localhost` here would be the container itself: use this machine's
# IP / DNS name, or join the Debezium stack's Docker network (see docker-compose.stack.yml: Kafka is kafka:29092).
# The Kafka address must match KAFKA_HOST in Packages/cdc/.env.
KAFKA_BOOTSTRAP=<HOST_IP>:9222
ES_URL=http://<HOST_IP>:9200
ORACLE_DSN=(DESCRIPTION=(ENABLE=BROKEN)(RETRY_COUNT=3)(RETRY_DELAY=5)(TRANSPORT_CONNECT_TIMEOUT=10)(CONNECT_TIMEOUT=30)(ADDRESS=(PROTOCOL=TCP)(HOST=<ORACLE_HOST>)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=emob)))

# --- Optional ----------------------------------------------------------------------------------------------
# CDC_GROUP=cdc-es-sync

# Docker only (docker-compose.yml): host port for /health and /metrics, image tag, timezone of the container
# METRICS_PORT=9108
# CDC_ES_SYNC_VERSION=1.0.0
# TZ=Asia/Dhaka
