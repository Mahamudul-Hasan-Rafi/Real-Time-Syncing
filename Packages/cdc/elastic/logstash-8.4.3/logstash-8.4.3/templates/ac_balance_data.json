{
  "index_patterns": [
    "ac_balance_data"
  ],
  "priority": 200,
  "version": 1,
  "_meta": {
    "description": "Managed by logstash-pipeline; schema is a strict contract with the SQL."
  },
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "number_of_replicas": 0,
        "refresh_interval": "30s"
      }
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "ac_id": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "ac_no": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "ac_title": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "age": {
          "type": "long"
        },
        "balance": {
          "type": "scaled_float",
          "scaling_factor": 1000
        },
        "balance_date": {
          "type": "date"
        },
        "create_by": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "create_date": {
          "type": "date"
        },
        "cust_code": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "cust_dob": {
          "type": "date"
        },
        "cust_no": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "cust_type": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "dep_nature": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "district": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "education": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "etl_loaded_at": {
          "type": "date"
        },
        "etl_pipeline": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "gender": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "location_type": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "mar_status": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "occupation": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "open_date": {
          "type": "date"
        },
        "point_category": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "point_name": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "product": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "tags": {
          "type": "keyword",
          "ignore_above": 1024
        }
      }
    }
  }
}
