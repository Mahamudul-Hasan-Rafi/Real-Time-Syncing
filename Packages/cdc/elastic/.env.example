# Copy to .env in this folder (it is git-ignored). Read by `docker compose` (ports, memory) and by the Logstash
# load scripts (scripts/run_pipelines.cmd|sh). Variables already set in the environment win.

# --- Elasticsearch security (REQUIRED). Elasticsearch runs with a password login and HTTPS.
# ES_PASSWORD is the password of the built-in "elastic" user. Logstash, the sync service and the scripts use it too.
# KIBANA_PASSWORD is the password of the internal kibana_system user (Kibana talks to Elasticsearch with it); you log in
# to Kibana as "elastic" / ES_PASSWORD. Use strong passwords without quotes, backslashes or spaces.
# ES_HOST_IP is this machine's IP: it goes into the server certificate, so clients connecting by that IP trust it.
ES_PASSWORD=
KIBANA_PASSWORD=
ES_HOST_IP=
# The certificates are created on the first `docker compose up -d`; clients trust ./ca/ca.crt (git-ignored).

# --- Logstash initial load: Oracle credentials (required unless config/logstash.keystore holds them)
ORACLE_USER=
ORACLE_PASSWORD=
# Defaults point at the dev database / Elasticsearch of this project; set these for your own environment:
# ORACLE_JDBC_URL=jdbc:oracle:thin:@//<ORACLE_HOST>:1521/emob
# ES_HOSTS=https://<ES_HOST_IP>:9200
# ES_USER=elastic
# ES_CA_CERT=../../ca/ca.crt        (relative to the Logstash folder; default shown)

# --- Elasticsearch / Kibana containers (docker-compose.yml). The defaults need about 12 GB for Elasticsearch.
# ES_PORT=9200
# KIBANA_PORT=5601
# ES_HEAP=8g
# ES_MEM_LIMIT=12g

# --- Logstash heap. config/jvm.options asks for -Xms4g -Xmx4g, which needs 4 GB of free memory *commit* up front.
# On a small or busy machine the JVM then dies at once with "paging file is too small" / "insufficient memory".
# Starting smaller works just as well for this load (appended after jvm.options, so it wins):
# LS_JAVA_OPTS=-Xms1g -Xmx4g
