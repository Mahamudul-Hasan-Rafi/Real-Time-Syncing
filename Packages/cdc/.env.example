# Copy to .env in this folder (it is git-ignored) BEFORE the first `docker compose up -d`. Docker Compose reads it
# automatically. Never commit the real file.

# --- Oracle (read by connector-init to register the Debezium connector emob-oracle-cdc)
ORACLE_HOST=
# ORACLE_PORT=1521
CDC_USER_PASSWORD=

# --- Kafka. KAFKA_HOST is the address clients OUTSIDE Docker (the sync service on another host, Logstash tools,
#     kafka-ui on a laptop ...) use to reach the broker: this machine's IP or DNS name. The default below is the
#     dev server of this project and is wrong anywhere else.
KAFKA_HOST=
# KAFKA_PORT=9222

# --- Kafka UI login (required). Use a strong password.
# KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=

# --- Optional ports and passwords
# CONNECT_PORT=8083
# UI_PORT=8085
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# GRAFANA_PASSWORD=change-me


KAFKA_HOST=10.11.200.109
ORACLE_HOST=10.11.200.37
KAFKA_UI_PASSWORD=12345
# KAFKA_PORT=9222
# KAFKA_UI_USER=admin
# CONNECT_PORT=8083
# UI_PORT=8085
