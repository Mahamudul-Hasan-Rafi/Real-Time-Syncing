{
  "uid": "kafka-topics",
  "title": "Topics & Consumer Groups",
  "description": "Topic inventory and throughput, consumer group lag and catch-up time",
  "tags": [
    "kafka",
    "debezium",
    "cdc"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "links": [
    {
      "title": "Operations Center",
      "type": "link",
      "url": "/d/cdc-ops",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false
    },
    {
      "title": "Debezium Connectors",
      "type": "link",
      "url": "/d/cdc-connectors",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false
    },
    {
      "title": "Kafka Cluster",
      "type": "link",
      "url": "/d/kafka-cluster",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "topic",
        "label": "Topic",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": "label_values(kafka_topic_partitions, topic)",
        "definition": "label_values(kafka_topic_partitions, topic)",
        "regex": "/^(?!__).*/",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      },
      {
        "name": "group",
        "label": "Consumer group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": "label_values(kafka_consumergroup_members, consumergroup)",
        "definition": "label_values(kafka_consumergroup_members, consumergroup)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
