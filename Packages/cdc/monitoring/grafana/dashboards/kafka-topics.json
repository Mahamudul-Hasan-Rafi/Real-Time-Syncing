    {
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "type": "table",
      "title": "Consumer groups",
      "description": "Catch-up time = lag / current consume rate. INACTIVE: messages are waiting but no consumer is in the group.",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "clamp_max((sum by (consumergroup) (clamp_min(kafka_consumergroup_lag{consumergroup=~\"$group\"}, 0)) > bool 1000) + 2 * ((max by (consumergroup) (kafka_consumergroup_members{consumergroup=~\"$group\"}) == bool 0) * (sum by (consumergroup) (clamp_min(kafka_consumergroup_lag{consumergroup=~\"$group\"}, 0)) > bool 0)), 2)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (consumergroup) (kafka_consumergroup_members{consumergroup=~\"$group\"})",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (consumergroup) (clamp_min(kafka_consumergroup_lag{consumergroup=~\"$group\"}, 0))",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (consumergroup) (rate(kafka_consumergroup_current_offset{consumergroup=~\"$group\"}[5m]))",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (consumergroup) (clamp_min(kafka_consumergroup_lag{consumergroup=~\"$group\"}, 0)) / (sum by (consumergroup) (rate(kafka_consumergroup_current_offset{consumergroup=~\"$group\"}[5m])) > 0)",
          "legendFormat": "",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "count by (consumergroup) (count by (consumergroup, topic) (kafka_consumergroup_lag{consumergroup=~\"$group\"}))",
          "legendFormat": "",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "consumergroup",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true
            },
            "indexByName": {
              "consumergroup": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6
            },
            "renameByName": {
